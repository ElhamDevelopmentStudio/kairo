{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json", "../../tsconfig.base.json"]
    },
    "lint": {
      "inputs": ["src/**/*.{ts,tsx}", "../../biome.json"]
    },
    "test": {
      "inputs": ["src/**/*.{ts,tsx,json}", "test/**/*.{ts,tsx}", "../../vitest.config.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
