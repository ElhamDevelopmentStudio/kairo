{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "inputs": [
        "src/**/*.{ts,tsx,astro,md,mdx}",
        "tsconfig.json",
        "astro.config.mjs",
        "../../tsconfig.base.json"
      ]
    },
    "lint": {
      "inputs": ["src/**/*.{ts,tsx,astro,md,mdx}", "astro.config.mjs", "../../biome.json"]
    },
    "test": {
      "inputs": [
        "src/**/*.{ts,tsx,json,astro,md,mdx}",
        "test/**/*.{ts,tsx}",
        "../../vitest.config.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "astro.config.mjs", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
