{
  "name": "@kairohq/cli",
  "version": "0.0.1",
  "private": false,
  "description": "Kairo command-line interface for local-first project memory.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kairo": "./bin/kairo.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --filter @kairohq/web build && tsx src/bin.ts serve --no-open --port 4170",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src bin",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@kairohq/ai": "workspace:*",
    "@kairohq/core": "workspace:*",
    "@kairohq/shared": "workspace:*",
    "commander": "^12.1.0",
    "hono": "^4.12.21",
    "kleur": "^4.1.5",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
