{
  "name": "@kairo/mcp",
  "version": "0.0.1",
  "private": false,
  "description": "Kairo MCP server for exposing local project memory to assistants.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kairo-mcp": "./bin/kairo-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src bin",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairo/ai": "workspace:*",
    "@kairo/core": "workspace:*",
    "@kairo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
