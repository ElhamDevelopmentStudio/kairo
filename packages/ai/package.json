{
  "name": "@kairohq/ai",
  "version": "0.0.1",
  "private": false,
  "description": "AI provider and answer helpers for Kairo.",
  "license": "MIT",
  "homepage": "https://github.com/ElhamDevelopmentStudio/kairo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElhamDevelopmentStudio/kairo.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/ElhamDevelopmentStudio/kairo/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./provider": "./src/provider/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairohq/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
