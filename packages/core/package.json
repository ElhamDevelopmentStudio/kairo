{
  "name": "@kairohq/core",
  "version": "0.0.1",
  "private": false,
  "description": "Core observation, storage, reconstruction, and memory logic for Kairo.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairohq/shared": "workspace:*",
    "@kairohq/utils": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^4.0.0",
    "simple-git": "^3.27.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.6.2"
  }
}
