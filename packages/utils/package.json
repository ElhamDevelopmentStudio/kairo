{
  "name": "@kairo/utils",
  "version": "0.0.1",
  "private": false,
  "description": "Utility helpers for Kairo packages.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./date": "./src/date/index.ts",
    "./slug": "./src/slug/index.ts",
    "./fs": "./src/fs/index.ts",
    "./id": "./src/id/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
