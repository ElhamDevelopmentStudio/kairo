{
  "name": "@kairohq/shared",
  "version": "0.0.1",
  "private": false,
  "description": "Shared schemas and types for Kairo.",
  "license": "MIT",
  "homepage": "https://github.com/ElhamDevelopmentStudio/kairo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElhamDevelopmentStudio/kairo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/ElhamDevelopmentStudio/kairo/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai.ts",
    "./events": "./src/events.ts",
    "./session": "./src/session.ts",
    "./symbol": "./src/symbol.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
